{
  "name": "elasticity-backend",
  "private": true,
  "version": "1.0.0",
  "description": "API del Price Elasticity Engine: baja los datos de Bodesa de S3, calcula y los sirve a la app",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "bodesa": "node --env-file-if-exists=.env bodesa/pipeline.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.716.0"
  }
}
