# Copia este archivo como backend/.env (está en .gitignore: nunca lo subas a git).
# Mismas llaves que backend/.env del proyecto Cascaron. Si las dejas vacías se usa el perfil de AWS CLI (~/.aws/credentials).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=data-bunker-prod-env

# Puerto de la API (Vite redirige /api aquí) y cada cuántos minutos se revisa si S3 tiene datos nuevos
BACKEND_PORT=8011
CHECK_MIN=30
